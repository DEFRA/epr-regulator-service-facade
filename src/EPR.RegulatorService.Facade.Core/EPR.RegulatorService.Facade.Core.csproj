<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EPR.RegulatorService.Facade.Core</AssemblyName>
    <RootNamespace>EPR.RegulatorService.Facade.Core</RootNamespace>
    <NoWarn>S3903, S5144</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="GovukNotify" Version="8.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.ApplicationInsights" Version="2.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <SonarQubeSetting Include="sonar.coverage.exclusions">
      <Value>**/AddressModel.cs,**/EnrolmentDetails.cs,**/OrganisationDetailModel.cs,**/OrganisationSearchResult.cs,**/UserDetailsModel.cs,**/UserOrganisationsListModel.cs,**/UserEnrolmentDetails.cs,**/TransferDetails.cs,**/PomSubmissionSummaryResponse.cs</Value>
    </SonarQubeSetting>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
  </ItemGroup>

</Project>
